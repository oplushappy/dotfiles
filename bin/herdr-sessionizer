#!/usr/bin/env bash
# herdr-sessionizer — tmux-sessionizer for herdr
# Pick an open herdr workspace (local or on a saved SSH machine) or a project dir with fzf.
#   workspace -> focus it            (ctrl-x closes it)
#   dir       -> focus the workspace that has a pane in that dir, or create one
#
# Usage: herdr-sessionizer [dir]
# Search roots: HERDR_SESSIONIZER_DIRS (space-separated), default below.
# Remote machines: every enabled `herdr machine`; skipped if unreachable within
# HERDR_SESSIONIZER_REMOTE_TIMEOUT seconds (default 3, 0 disables remote listing).

set -euo pipefail

read -ra roots <<< "${HERDR_SESSIONIZER_DIRS:-$HOME/Projects $HOME/cc}"
depth=${HERDR_SESSIONIZER_DEPTH:-2}
remote_timeout=${HERDR_SESSIONIZER_REMOTE_TIMEOUT:-3}

for cmd in herdr jq fzf; do
    command -v "$cmd" >/dev/null || { echo "herdr-sessionizer: missing '$cmd'" >&2; exit 1; }
done

# Entry kinds and targets:
#   ws   <workspace_id>              local workspace
#   rws  <machine>/<workspace_id>    workspace on a saved SSH machine
#   dir  <path>                      local project directory

# Run a herdr API command locally (machine "") or on a saved machine.
on() {
    local machine=$1; shift
    if [[ -n $machine ]]; then herdr --machine "$machine" "$@"; else herdr "$@"; fi
}

# Split a target into $machine and $ws_id.
parse_target() {
    if [[ $1 == rws ]]; then machine=${2%%/*}; ws_id=${2#*/}; else machine=""; ws_id=$2; fi
}

# Internal: fzf preview  (herdr-sessionizer --preview <kind> <target>)
if [[ ${1:-} == --preview ]]; then
    case $2 in
        ws|rws)
            parse_target "$2" "$3"
            on "$machine" pane list --workspace "$ws_id" | jq -r '.result.panes[] |
                "\(.tab_id)  \(.cwd | sub("^'"$HOME"'"; "~"))  \(.agent // "")  \(.terminal_title_stripped // "")"' ;;
        *) ls -A --color=always "$3" ;;
    esac
    exit 0
fi

ws_json=$(herdr workspace list)

focus_or_create() {
    local dir label ws_id
    dir=$(realpath "$1")
    # Prefer a workspace that already has a pane in this dir, then one with the same label.
    ws_id=$(herdr pane list | jq -r --arg d "$dir" \
        '[.result.panes[] | select(.cwd == $d)][0].workspace_id // empty')
    label=$(basename "$dir" | tr '.:' '__')
    if [[ -z $ws_id ]]; then
        ws_id=$(jq -r --arg l "$label" \
            '[.result.workspaces[] | select(.label == $l)][0].workspace_id // empty' <<< "$ws_json")
    fi
    if [[ -n $ws_id ]]; then
        herdr workspace focus "$ws_id" >/dev/null
    else
        herdr workspace create --cwd "$dir" --label "$label" --focus >/dev/null
    fi
}

list_remote() {
    [[ $remote_timeout == 0 ]] && return 0
    local m json
    herdr machine list 2>/dev/null | awk -F'\t' '$5 == "enabled" {print $2}' |
        while IFS= read -r m; do
            json=$(timeout "$remote_timeout" herdr --machine "$m" workspace list 2>/dev/null) || continue
            jq -r --arg m "$m" '.result.workspaces[] |
                "rws\t\($m)/\(.workspace_id)\t\u001b[36m[\($m)]\u001b[0m \(.label)  \u001b[90m\(.tab_count) tabs · \(.agent_status)\u001b[0m"' \
                <<< "$json" 2>/dev/null || true
        done
}

# Each line: <kind> TAB <target> TAB <display>
list_entries() {
    ws_json=$(herdr workspace list)
    jq -r '.result.workspaces[] |
        "ws\t\(.workspace_id)\t\u001b[33m[ws]\u001b[0m \(.label)  \u001b[90m\(.tab_count) tabs · \(.agent_status)\u001b[0m"' \
        <<< "$ws_json"
    list_remote
    for r in "${roots[@]}"; do
        [[ -d $r ]] || continue
        find "$r" -mindepth 1 -maxdepth "$depth" -name '.*' -prune -o -type d -print 2>/dev/null | sort |
            while IFS= read -r d; do
                printf 'dir\t%s\t%s\n' "$d" "${d/#$HOME/\~}"
            done
    done
}

# Internal: used by fzf bindings
case ${1:-} in
    --list)  list_entries; exit 0 ;;
    --close)
        if [[ $2 == ws || $2 == rws ]]; then
            parse_target "$2" "$3"
            on "$machine" workspace close "$ws_id" >/dev/null || true
        fi
        exit 0 ;;
esac

if [[ $# -ge 1 ]]; then
    focus_or_create "$1"
    exit 0
fi

self=$(realpath "$0")
choice=$(list_entries | fzf --ansi --prompt='herdr> ' --delimiter='\t' --with-nth=3 \
    --header='enter: open · ctrl-x: close workspace' \
    --bind="ctrl-x:execute-silent('$self' --close {1} {2})+reload('$self' --list)" \
    --preview="'$self' --preview {1} {2}") || exit 0

IFS=$'\t' read -r kind target _ <<< "$choice"
case $kind in
    ws|rws) parse_target "$kind" "$target"; on "$machine" workspace focus "$ws_id" >/dev/null ;;
    dir)    focus_or_create "$target" ;;
esac
